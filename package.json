{
  "name": "@htmlp/core",
  "version": "0.1.0-alpha.1",
  "description": "Kill the prompt monolith. HTML-compatible prompts with enforceable context budgets.",
  "type": "module",
  "license": "MIT",
  "author": "HTMLP contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexmckenley/htmlp.git"
  },
  "homepage": "https://alexmckenley.github.io/htmlp/",
  "bugs": "https://github.com/alexmckenley/htmlp/issues",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "htmlp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm test && npm run schema:check",
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs --check",
    "docs:api": "typedoc && node scripts/copy-docs.mjs",
    "docs:build": "npm run docs:api && npm --prefix site run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "prompt",
    "agents",
    "html",
    "linter",
    "context",
    "ast"
  ],
  "dependencies": {
    "parse5": "^8.0.0",
    "parse5-sax-parser": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "tsx": "^4.20.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "typescript-json-schema": "^0.65.0"
  }
}

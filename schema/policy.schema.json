{
  "description": "All character budgets count Unicode code points, NOT model tokens.",
  "type": "object",
  "properties": {
    "maxFileChars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxSectionChars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxSystemChars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxUserChars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxContextChars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxSections": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allowedRoles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Role"
      }
    },
    "requiredSections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowFreeText": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Role": {
      "description": "Roles supported by version 0.1. Provider adaptation belongs to the caller.",
      "type": "string",
      "enum": [
        "system",
        "user"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTMLP Policy 0.1",
  "$id": "https://alexmckenley.github.io/htmlp/schema/policy.schema.json"
}
